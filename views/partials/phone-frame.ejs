<%
  const frameMaxW = typeof maxWidthClass !== 'undefined' ? maxWidthClass : 'max-w-[240px]';
  const hoverRing = typeof ringHoverClass !== 'undefined' ? ringHoverClass : 'group-hover:ring-primary/50';
%>
<div class="w-full <%= frameMaxW %> mx-auto relative select-none">
  <div class="absolute -left-[3px] top-16 w-[3px] h-7 bg-surface-bright rounded-l-sm pointer-events-none"></div>
  <div class="absolute -left-[3px] top-28 w-[3px] h-11 bg-surface-bright rounded-l-sm pointer-events-none"></div>
  <div class="absolute -right-[3px] top-24 w-[3px] h-14 bg-surface-bright rounded-r-sm pointer-events-none"></div>

  <div class="bg-surface-container-highest p-2 sm:p-2.5 rounded-[2.2rem] shadow-[0_20px_50px_rgba(0,0,0,0.85)] ring-1 ring-white/15 <%= hoverRing %> transition-all duration-300">
    <div class="w-16 h-3 bg-surface-container-lowest rounded-full mx-auto mb-1.5 flex items-center justify-center gap-1.5">
      <div class="w-5 h-1 bg-surface-bright rounded-full"></div>
      <div class="w-1.5 h-1.5 bg-surface-bright/80 rounded-full"></div>
    </div>

    <div class="rounded-[1.6rem] overflow-hidden bg-surface-container-lowest relative aspect-[9/19.2] ring-1 ring-black/70">
      <img
        <% if (typeof imgId !== 'undefined' && imgId) { %>id="<%= imgId %>"<% } %>
        alt="<%= alt %>"
        src="<%= image %>"
        class="w-full h-full object-cover mockup-scroll-img"
        <% if (typeof fetchpriority !== 'undefined' && fetchpriority) { %>fetchpriority="<%= fetchpriority %>"<% } %>
        <% if (typeof loading !== 'undefined' && loading) { %>loading="<%= loading %>"<% } %>
        width="340"
        height="725"
      >
      <% if (typeof showZoomBadge !== 'undefined' && showZoomBadge) { %>
        <div class="absolute bottom-3 right-3 bg-surface-container-lowest/90 backdrop-blur-md px-2.5 py-1 rounded-full text-[11px] font-label-sm text-primary flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity shadow-md border border-white/10">
          <span class="material-symbols-outlined text-[14px]">zoom_in</span> Ampliar
        </div>
      <% } %>
    </div>

    <div class="w-20 h-1 bg-white/25 rounded-full mx-auto mt-2"></div>
  </div>
</div>
