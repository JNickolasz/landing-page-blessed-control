          <div class="flex flex-wrap items-center justify-center gap-space-md text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-primary text-[16px]">check_circle</span> Instalação Instantânea
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-primary text-[16px]">check_circle</span> Sem Cadastro de Cartão
            </span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-primary text-[16px]">check_circle</span> Padrão Blessed JJ
            </span>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer class="w-full bg-surface-container-lowest py-space-xl shadow-[0_-1px_12px_rgba(0,0,0,0.4)] border-t border-white/5">
