          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
            <% testimonials.forEach(function(item) { %>
              <div class="scroll-reveal flex flex-col justify-between p-space-lg bg-surface-container rounded-2xl shadow-sm border border-white/5">
                <p class="font-body-md text-body-md text-on-surface-variant italic mb-space-md">
                  "<%= item.quote %>"
                </p>
                <div class="flex items-center gap-space-sm">
                  <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center <%= item.colorClass %> font-bold">
                    <%= item.initials %>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-label-lg text-label-lg font-bold text-on-surface"><%= item.name %></span>
                    <span class="font-body-sm text-body-sm <%= item.colorClass %>"><%= item.role %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

