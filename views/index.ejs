                <%= index === 0 ? 'open' : '' %>
              >
                <summary class="w-full p-space-md flex items-center justify-between text-left hover:bg-surface-container-high transition-colors cursor-pointer">
                  <span class="font-headline-sm text-headline-sm font-semibold text-on-surface pr-4"><%= faq.question %></span>
                  <span class="material-symbols-outlined text-primary transition-transform duration-200 faq-chevron shrink-0">expand_more</span>
                </summary>
                <div class="px-space-md pb-space-md pt-0 text-on-surface-variant font-body-md text-body-md">
                  <%= faq.answer %>
                </div>
              </details>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="w-full bg-gradient-to-b from-surface to-surface-container-lowest py-8 sm:py-space-xl lg:py-24 px-4 sm:px-6 lg:px-12 relative overflow-hidden border-t border-white/5">
