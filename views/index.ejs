  <div class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-surface-container-lowest/95 backdrop-blur-xl border-t border-white/10 px-4 py-2.5 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <img src="<%= meta.logo %>" alt="Blessed Control" width="32" height="32" class="w-8 h-8 rounded-full object-cover ring-1 ring-primary/40">
      <div class="flex flex-col">
        <span class="font-label-md text-label-md text-on-surface font-bold">Blessed Control <%= meta.version %></span>
        <span class="font-body-sm text-[10px] text-primary">APK Oficial • <%= meta.apkSize %></span>
      </div>
