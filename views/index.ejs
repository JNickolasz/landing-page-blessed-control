          <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#download-apk-section">Download Oficial</a>
          <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#faq-section">Políticas &amp; Segurança</a>
          <span class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"><%= meta.headCoach %></span>
          <span class="font-body-sm text-body-sm text-on-surface-variant"><%= meta.location %></span>
          <span class="font-label-sm text-label-sm text-outline-variant"><%= meta.build %></span>
