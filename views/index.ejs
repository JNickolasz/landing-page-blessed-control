        <div class="flex flex-col gap-space-xs">
          <h4 class="font-label-md text-label-md text-primary uppercase mb-space-xs">Comunidade</h4>
          <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#vitrine-app-section" onclick="setSimulatorRole('aluno'); switchTab('aluno')">Área do Aluno</a>
          <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#vitrine-app-section" onclick="setSimulatorRole('professor'); switchTab('professor')">Painel de Professores</a>
