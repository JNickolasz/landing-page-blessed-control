    <a
      href="<%= meta.apkDownloadUrl %>"
      download="<%= meta.apkFileName %>"
      onclick="triggerApkDownload()"
      class="px-3.5 py-2 rounded-lg bg-primary-container text-on-primary-container font-label-md text-label-md font-bold flex items-center gap-1 shadow-md"
