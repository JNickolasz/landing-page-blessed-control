      <span class="material-symbols-outlined text-[18px]">download</span>
      <span>Baixar</span>
    </a>
  </div>

  <dialog
    id="screen-lightbox"
    closedby="any"
    aria-labelledby="lightbox-title"
    class="bg-surface-container text-on-surface rounded-2xl p-0 max-w-md w-[92vw] max-h-[90vh] max-h-[90dvh] shadow-2xl border border-white/10 overflow-hidden"
  >
    <div class="flex flex-col h-full max-h-[90vh] max-h-[90dvh]">
      <div class="p-space-md bg-surface-container-highest flex items-center justify-between border-b border-white/10 shrink-0 gap-2">
        <div class="flex flex-col min-w-0">
          <div class="flex items-center gap-2">
            <span id="lightbox-badge" class="font-label-sm text-label-sm text-primary uppercase">VISUALIZAÇÃO DA TELA</span>
            <span id="lightbox-counter" class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-[10px] text-on-surface-variant">1 / 15</span>
          </div>
          <h3 id="lightbox-title" class="font-headline-sm text-headline-sm font-bold text-on-surface truncate"></h3>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button
            type="button"
            onclick="navigateLightbox(-1)"
            aria-label="Tela anterior (Seta Esquerda)"
            title="Tela anterior (←)"
            class="w-9 h-9 rounded-lg bg-surface-container hover:bg-surface-bright text-on-surface flex items-center justify-center transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
          </button>
          <button
            type="button"
            onclick="navigateLightbox(1)"
            aria-label="Próxima tela (Seta Direita)"
            title="Próxima tela (→)"
            class="w-9 h-9 rounded-lg bg-surface-container hover:bg-surface-bright text-on-surface flex items-center justify-center transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </button>
          <button
            type="button"
            onclick="closeLightbox()"
            aria-label="Fechar visualização"
            title="Fechar (Esc)"
            class="w-9 h-9 rounded-lg bg-surface-container hover:bg-surface-bright text-on-surface flex items-center justify-center transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
      </div>
      <div class="p-space-md overflow-y-auto flex-1 flex flex-col items-center gap-space-md bg-surface-container-lowest">
        <p id="lightbox-desc" class="font-body-sm text-body-sm text-on-surface-variant text-center"></p>
        <div class="w-full rounded-xl overflow-hidden border border-white/10 shadow-lg">
          <img id="lightbox-img" src="" alt="" class="w-full h-auto block">
        </div>
      </div>
    </div>
  </dialog>

  <div
    id="apk-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-16 sm:bottom-6 inset-x-4 sm:left-auto sm:right-6 z-50 sm:max-w-sm bg-surface-container-highest text-on-surface p-space-md rounded-xl shadow-2xl border border-primary/40 flex items-start gap-space-sm translate-y-24 opacity-0 pointer-events-none transition-all duration-300"
  >
    <span class="material-symbols-outlined text-primary text-[24px] shrink-0">check_circle</span>
    <div class="flex flex-col gap-1">
      <span class="font-label-lg text-label-lg text-on-surface">Download do APK Iniciado</span>
      <span class="font-body-sm text-body-sm text-on-surface-variant">
        Blessed Control <%= meta.version %> (<%= meta.apkSize %>) verificado pela Blessed Academy.
      </span>
    </div>
  </div>

  <script>
    const simulatorData = <%- JSON.stringify(simulator) %>;
    const showcaseData = <%- JSON.stringify(showcase) %>;
    const beltsData = <%- JSON.stringify(belts) %>;
    let currentSimRole = 'aluno';
    let currentSimTabIndex = 0;

    const allScreensGallery = [
      ...showcaseData.aluno,
      ...showcaseData.alunoExtras,
      ...showcaseData.professor,
      ...showcaseData.professorExtras
    ];
    let currentLightboxIndex = 0;

    function handleCardKeydown(event, callback) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        callback();
      }
    }

    function setSimulatorRole(role) {
      currentSimRole = role;
      currentSimTabIndex = 0;
      const btnAluno = document.getElementById('sim-role-aluno');
      const btnProf = document.getElementById('sim-role-professor');
      if (role === 'aluno') {
        btnAluno.className = 'px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1';
        btnProf.className = 'px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1';
        btnAluno.setAttribute('aria-pressed', 'true');
        btnProf.setAttribute('aria-pressed', 'false');
      } else {
        btnProf.className = 'px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1';
        btnAluno.className = 'px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1';
        btnProf.setAttribute('aria-pressed', 'true');
        btnAluno.setAttribute('aria-pressed', 'false');
      }
      renderSimulatorTabs();
      selectSimulatorTab(0);
    }

    function renderSimulatorTabs() {
      const bar = document.getElementById('sim-tabs-bar');
      const items = simulatorData[currentSimRole];
      bar.innerHTML = items.map((t, idx) => `
        <button
          type="button"
          aria-pressed="${idx === currentSimTabIndex ? 'true' : 'false'}"
          onclick="selectSimulatorTab(${idx})"
          class="sim-tab-btn flex flex-col items-center justify-center py-2 sm:py-2.5 px-0.5 sm:px-1 rounded-xl transition-all min-w-0 ${idx === currentSimTabIndex ? 'bg-primary-container text-on-primary-container font-bold shadow-md' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface'}"
        >
          <span class="material-symbols-outlined text-[18px] sm:text-[20px]">${t.icon}</span>
          <span class="font-label-sm text-[10px] sm:text-[11px] mt-1 truncate max-w-full">${t.tab}</span>
        </button>
      `).join('');
    }

    function selectSimulatorTab(index) {
      currentSimTabIndex = index;
      const item = simulatorData[currentSimRole][index];
      document.getElementById('sim-badge').textContent = item.badge;
      document.getElementById('sim-title').textContent = item.title;
      document.getElementById('sim-desc').textContent = item.description;
      const img = document.getElementById('sim-phone-img');
      img.src = item.image;
      img.alt = item.title;
      renderSimulatorTabs();
    }

    function openSimulatorLightbox() {
      const item = simulatorData[currentSimRole][currentSimTabIndex];
      openLightbox(item.image, item.title, item.description);
    }

    const activeTabClass =
      'px-3 sm:px-space-md py-2.5 rounded-lg font-label-lg text-xs sm:text-label-lg transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1.5 shadow-sm';
    const inactiveTabClass =
      'px-3 sm:px-space-md py-2.5 rounded-lg font-label-lg text-xs sm:text-label-lg transition-all text-on-surface-variant hover:text-on-surface font-medium flex items-center justify-center gap-1.5';

    function switchTab(role) {
      const tabAluno = document.getElementById('tab-aluno');
      const tabProf = document.getElementById('tab-professor');
      const contentAluno = document.getElementById('content-aluno');
      const contentProf = document.getElementById('content-professor');

      if (role === 'aluno') {
        tabAluno.className = activeTabClass;
        tabProf.className = inactiveTabClass;
        tabAluno.setAttribute('aria-selected', 'true');
        tabAluno.setAttribute('aria-expanded', 'true');
        tabProf.setAttribute('aria-selected', 'false');
        tabProf.setAttribute('aria-expanded', 'false');
        contentAluno.removeAttribute('hidden');
        contentProf.setAttribute('hidden', 'until-found');
      } else {
        tabProf.className = activeTabClass;
        tabAluno.className = inactiveTabClass;
        tabProf.setAttribute('aria-selected', 'true');
        tabProf.setAttribute('aria-expanded', 'true');
        tabAluno.setAttribute('aria-selected', 'false');
        tabAluno.setAttribute('aria-expanded', 'false');
        contentProf.removeAttribute('hidden');
        contentAluno.setAttribute('hidden', 'until-found');
      }
    }

    const showcaseContainer = document.getElementById('showcase-tabs-container');
    if (showcaseContainer) {
      showcaseContainer.addEventListener('beforematch', (e) => {
        const matchedPanel = e.target.closest('.showcase-panel');
        if (!matchedPanel) return;
        if (matchedPanel.id === 'content-professor') {
          switchTab('professor');
        } else if (matchedPanel.id === 'content-aluno') {
          switchTab('aluno');
        }
      });
    }

    if (!('onbeforematch' in HTMLElement.prototype)) {
      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
        el.removeAttribute('hidden');
        const id = el.getAttribute('id');
        if (id) {
          document.querySelectorAll(`[aria-controls="${id}"]`).forEach((ctrl) => {
            ctrl.setAttribute('aria-expanded', 'true');
          });
        }
      });
    }

    function filterSchedule(type) {
      document.querySelectorAll('.sched-filter-btn').forEach((btn) => {
        const isSelected = btn.dataset.filter === type;
        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        if (isSelected) {
          btn.className = 'sched-filter-btn px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm bg-primary-container text-on-primary-container font-bold transition-all text-center';
        } else {
          btn.className = 'sched-filter-btn px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-all text-center';
        }
      });
      document.querySelectorAll('.schedule-item').forEach((row) => {
        if (type === 'ALL' || row.dataset.type === type) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }

    let currentBeltCategory = 'adulto';
    let currentBeltIndex = 0;

    function setBeltCategory(category) {
      currentBeltCategory = category;
      currentBeltIndex = 0;
      const btnAdulto = document.getElementById('belt-cat-adulto');
      const btnKids = document.getElementById('belt-cat-kids');
      if (category === 'adulto') {
        btnAdulto.className = 'px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm bg-primary-container text-on-primary-container font-bold transition-all text-center';
        btnKids.className = 'px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-all text-center';
        btnAdulto.setAttribute('aria-pressed', 'true');
        btnKids.setAttribute('aria-pressed', 'false');
      } else {
        btnKids.className = 'px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm bg-primary-container text-on-primary-container font-bold transition-all text-center';
        btnAdulto.className = 'px-3 py-1.5 sm:py-1 rounded-lg font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-all text-center';
        btnKids.setAttribute('aria-pressed', 'true');
        btnAdulto.setAttribute('aria-pressed', 'false');
      }
      renderBeltButtons();
      selectBelt(0);
    }

    function renderBeltButtons() {
      const grid = document.getElementById('belt-selector-grid');
      if (!grid) return;
      const list = beltsData[currentBeltCategory];
      grid.innerHTML = list.map((belt, idx) => `
        <button
          type="button"
          aria-pressed="${idx === currentBeltIndex ? 'true' : 'false'}"
          onclick="selectBelt(${idx})"
          class="belt-btn flex flex-col items-center gap-1.5 py-2 px-1 sm:p-2 rounded-xl border transition-all min-w-0 ${idx === currentBeltIndex ? 'bg-surface-container-high border-primary shadow-md' : 'bg-surface-container-lowest border-white/5 hover:border-white/20'}"
        >
          <div class="w-5 h-11 rounded-sm ${belt.colorBg} relative overflow-hidden flex flex-col justify-end shadow-inner shrink-0">
            <div class="w-full h-3.5 ${belt.pontaBg} mb-1 flex flex-col justify-evenly px-0.5">
              <div class="w-full h-[1.5px] bg-white/90"></div>
              <div class="w-full h-[1.5px] bg-white/90"></div>
            </div>
          </div>
          <span class="font-label-sm text-[9px] sm:text-[10px] text-on-surface truncate max-w-full">${belt.shortName}</span>
        </button>
      `).join('');
    }

    function selectBelt(index) {
      currentBeltIndex = index;
      const list = beltsData[currentBeltCategory];
      const belt = list[index];
      const titleEl = document.getElementById('belt-title');
      titleEl.textContent = belt.name;
      titleEl.className = `font-headline-sm text-headline-sm font-bold ${belt.textClass}`;
      document.getElementById('belt-age').textContent = belt.ageRule;
      document.getElementById('belt-classes').textContent = belt.degreesRule;
      document.getElementById('belt-ibjjf').textContent = belt.ibjjfMin;
      document.getElementById('belt-focus').textContent = belt.focus;
      renderBeltButtons();
    }

    const sectionIds = [
      'inicio-section',
      'vitrine-app-section',
      'grade-horarios-section',
      'download-apk-section',
      'depoimentos-section',
      'faq-section'
    ];
    const navLinks = document.querySelectorAll('.nav-item');

    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const activeId = entry.target.id;
            navLinks.forEach((link) => {
              if (link.dataset.navTarget === activeId) {
                link.className = 'nav-item transition-all py-space-xs px-3 rounded-lg font-label-lg text-label-lg bg-surface-container-high text-primary font-bold';
              } else {
                link.className = 'nav-item transition-all py-space-xs px-3 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface';
              }
            });
          }
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0 }
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) spyObserver.observe(el);
    });

    if (!CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0) scale(1)';
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.scroll-reveal').forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px) scale(0.98)';
        el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        revealObserver.observe(el);
      });
    }

    function syncBodyScrollLock() {
      const menu = document.getElementById('mobile-menu');
      const isMenuOpen = menu && !menu.classList.contains('hidden');
      const isDialogOpen = lightbox && lightbox.open;
      document.body.classList.toggle('overflow-hidden', Boolean(isMenuOpen || isDialogOpen));
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const btn = document.getElementById('mobile-menu-btn');
      const icon = document.getElementById('mobile-menu-icon');
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        icon.textContent = 'close';
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        icon.textContent = 'menu';
      }
      syncBodyScrollLock();
    }

    const lightbox = document.getElementById('screen-lightbox');

    function updateLightboxContent(imgSrc, title, desc, badgeText) {
      document.getElementById('lightbox-img').src = imgSrc;
      document.getElementById('lightbox-img').alt = title;
      document.getElementById('lightbox-title').textContent = title;
      document.getElementById('lightbox-desc').textContent = desc;
      document.getElementById('lightbox-badge').textContent = badgeText || 'VISUALIZAÇÃO DA TELA';
      document.getElementById('lightbox-counter').textContent = `${currentLightboxIndex + 1} / ${allScreensGallery.length}`;
    }

    function openLightbox(imgSrc, title, desc) {
      if (!lightbox) return;
      const foundIdx = allScreensGallery.findIndex((item) => item.image === imgSrc);
      currentLightboxIndex = foundIdx !== -1 ? foundIdx : 0;
      const badge = foundIdx !== -1 ? allScreensGallery[foundIdx].badge : 'VISUALIZAÇÃO DA TELA';
      updateLightboxContent(imgSrc, title, desc, badge);
      if (!lightbox.open) {
        lightbox.showModal();
      }
      syncBodyScrollLock();
    }

    function navigateLightbox(direction) {
      if (!allScreensGallery.length) return;
      currentLightboxIndex = (currentLightboxIndex + direction + allScreensGallery.length) % allScreensGallery.length;
      const screen = allScreensGallery[currentLightboxIndex];
      updateLightboxContent(screen.image, screen.title, screen.description, screen.badge);
    }

    function closeLightbox() {
      if (lightbox && lightbox.open) {
        lightbox.close();
      }
    }

    if (lightbox) {
      lightbox.addEventListener('close', syncBodyScrollLock);

      if (!('closedBy' in HTMLDialogElement.prototype)) {
        lightbox.addEventListener('click', (event) => {
          if (event.target !== lightbox) return;
          const rect = lightbox.getBoundingClientRect();
          const isDialogContent =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;
          if (isDialogContent) return;
          lightbox.close();
        });
      }

      window.addEventListener('keydown', (event) => {
        if (!lightbox.open) return;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          navigateLightbox(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          navigateLightbox(-1);
        }
      });
    }

    let apkToastTimeout;
    function triggerApkDownload() {
      const toast = document.getElementById('apk-toast');
      if (!toast) return;
      clearTimeout(apkToastTimeout);
      toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      apkToastTimeout = setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      }, 4000);
    }
  </script>
</body>
</html>
