<!DOCTYPE html>
<html class="dark scroll-smooth" lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="web_standard" name="shell-type">
  <meta name="description" content="<%= meta.description %>">
  <title><%= meta.title %></title>
  <link rel="icon" type="image/webp" href="<%= meta.logo %>">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=add_circle,admin_panel_settings,android,arrow_back,arrow_forward,auto_stories,badge,bolt,calendar_month,calendar_today,campaign,check_circle,checklist,close,collections_bookmark,dashboard,download,event,expand_more,fact_check,group,groups,home,info,manage_accounts,menu,military_tech,monitor_weight,notification_important,person,person_add,person_off,phone_android,photo_camera,qr_code,qr_code_2,qr_code_scanner,radar,rocket_launch,route,schedule,shield,sports,sports_kabaddi,sports_martial_arts,timer,touch_app,trending_up,tune,verified_user,video_library,workspace_premium,zoom_in&display=swap" rel="stylesheet">
  <% if (typeof compiledCss !== 'undefined' && compiledCss) { %>
  <style id="compiled-tailwind"><%- compiledCss %></style>
  <% } else { %>
  <link rel="stylesheet" href="/css/styles.css">
  <% } %>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container min-h-screen flex flex-col justify-between pb-16 sm:pb-0">

  <header class="fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.5)] border-b border-white/5">
    <div class="h-16 sm:h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between gap-2 sm:gap-space-md">
      <a href="#inicio-section" class="flex items-center gap-2.5 sm:gap-space-md group min-w-0">
        <img
          src="<%= meta.logo %>"
          alt="Blessed Control Logo"
          width="44"
          height="44"
          class="h-9 w-9 sm:h-11 sm:w-11 rounded-full shadow-md object-cover ring-1 ring-primary/40 group-hover:ring-primary transition-all shrink-0"
        >
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-base sm:text-headline-sm font-bold tracking-tight text-on-surface uppercase truncate">
            Blessed <span class="text-primary">Control</span>
          </span>
          <span class="font-label-sm text-[9px] sm:text-label-sm text-primary tracking-widest uppercase truncate">
            Blessed Academy Jiu-Jitsu
          </span>
        </div>
      </a>

      <nav class="hidden xl:flex items-center gap-1.5" aria-label="Navegação Principal" id="desktop-nav">
        <% navItems.forEach(function(nav, idx) { %>
          <a
            href="#<%= nav.id %>"
            data-nav-target="<%= nav.id %>"
            class="nav-item transition-all py-space-xs px-3 rounded-lg font-label-lg text-label-lg <%= idx === 0 ? 'bg-surface-container-high text-primary font-bold' : 'text-on-surface-variant hover:text-on-surface' %>"
          ><%= nav.label %></a>
        <% }); %>
      </nav>

      <div class="flex items-center gap-space-sm shrink-0">
        <a
          class="hidden sm:flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-primary-container text-on-primary-container hover:bg-secondary-container hover:text-on-secondary-container font-label-lg text-label-lg transition-all shadow-[0_0_20px_rgba(245,158,11,0.25)]"
          href="<%= meta.apkDownloadUrl %>"
          download="<%= meta.apkFileName %>"
          onclick="triggerApkDownload()"
        >
          <span class="material-symbols-outlined text-[20px]">download</span>
          <span>Baixar Blessed Control</span>
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menu de navegação"
          class="xl:hidden p-2 rounded-lg bg-surface-container-high text-on-surface hover:text-primary transition-colors flex items-center justify-center"
          onclick="toggleMobileMenu()"
        >
          <span class="material-symbols-outlined text-[24px]" id="mobile-menu-icon">menu</span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden xl:hidden bg-surface-container-lowest/95 backdrop-blur-xl border-b border-white/10 px-6 py-4">
      <div class="flex flex-col gap-1.5 max-w-7xl mx-auto">
        <% navItems.forEach(function(nav, idx) { %>
          <a
            class="py-2 px-3 rounded-lg hover:bg-surface-container-high text-on-surface font-label-lg flex items-center justify-between"
            href="#<%= nav.id %>"
            onclick="toggleMobileMenu()"
          >
            <span><%= idx + 1 %>. <%= nav.label %></span>
            <span class="material-symbols-outlined text-[16px] text-primary">arrow_forward</span>
          </a>
        <% }); %>
        <a
          class="mt-2 py-3 px-4 rounded-xl bg-primary-container text-on-primary-container font-label-lg text-center flex items-center justify-center gap-2"
          href="<%= meta.apkDownloadUrl %>"
          download="<%= meta.apkFileName %>"
          onclick="toggleMobileMenu(); triggerApkDownload()"
        >
          <span class="material-symbols-outlined text-[20px]">download</span>
          <span>Baixar Blessed Control (<%= meta.version %>)</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-16 sm:pt-20 bg-surface flex-1">
    <div class="flex flex-col w-full">

      <div id="inicio-section" class="scroll-mt-20">
        <section class="relative w-full overflow-hidden bg-surface py-8 sm:py-space-xl lg:py-24 px-4 sm:px-6 lg:px-12">
          <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[650px] h-[450px] bg-primary-container/10 blur-[130px] rounded-full pointer-events-none -z-0"></div>
          <div class="absolute top-1/3 right-10 w-[350px] h-[350px] bg-tertiary-container/10 blur-[120px] rounded-full pointer-events-none -z-0"></div>

          <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-8 sm:gap-space-xl relative z-10">
            <div class="w-full lg:w-1/2 flex flex-col items-start gap-space-md text-left">
              <div class="inline-flex items-center gap-space-xs px-3 sm:px-space-md py-1.5 rounded-full bg-surface-container-high border border-primary/20 shadow-sm max-w-full">
                <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse shrink-0"></span>
                <span class="font-label-sm text-[9px] sm:text-label-sm tracking-wider uppercase text-primary truncate"><%= hero.badge %></span>
              </div>

              <h1 class="font-display-lg text-[clamp(1.75rem,4.5vw+0.5rem,3rem)] font-black text-on-surface tracking-tight uppercase leading-[1.08]">
                <%= hero.titlePrefix %>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-container via-primary to-secondary"><%= hero.titleHighlight %></span>
              </h1>

              <p class="font-body-lg text-sm sm:text-body-lg text-on-surface-variant max-w-xl">
                <%= hero.subtitle %>
              </p>

              <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-space-md pt-space-xs w-full sm:w-auto">
                <a
                  class="flex items-center justify-center gap-space-xs px-4 sm:px-space-lg py-3.5 rounded-xl bg-primary-container hover:bg-secondary-container text-on-primary-container hover:text-on-secondary-container font-label-lg text-label-lg transition-all shadow-[0_4px_24px_rgba(245,158,11,0.35)] active:scale-95 text-center"
                  href="<%= meta.apkDownloadUrl %>"
                  download="<%= meta.apkFileName %>"
                  onclick="triggerApkDownload()"
                >
                  <span class="material-symbols-outlined text-[22px] shrink-0">download</span>
                  <span>Baixar Blessed Control APK (<%= meta.version %>)</span>
                </a>
                <a
                  class="flex items-center justify-center gap-space-xs px-4 sm:px-space-lg py-3.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-lg text-label-lg transition-colors border border-white/5 text-center"
                  href="#vitrine-app-section"
                >
                  <span class="material-symbols-outlined text-[20px] shrink-0">phone_android</span>
                  <span>Ver Vitrine &amp; Recursos</span>
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-sm w-full pt-space-sm sm:pt-space-md">
                <% hero.highlights.forEach(function(item) { %>
                  <div class="flex items-center gap-space-xs p-space-sm bg-surface-container rounded-lg border border-white/5">
                    <span class="material-symbols-outlined <%= item.colorClass %> text-[20px] shrink-0"><%= item.icon %></span>
                    <div class="flex flex-col min-w-0">
                      <span class="font-label-sm text-label-sm text-on-surface"><%= item.title %></span>
                      <span class="font-body-sm text-[11px] text-on-surface-variant"><%= item.subtitle %></span>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="w-full lg:w-1/2 flex items-center justify-center pt-2 lg:pt-0 relative">
              <div class="relative flex items-center justify-center gap-2.5 sm:gap-6 w-full max-w-lg px-1 sm:px-0">

                <div
                  role="button"
                  tabindex="0"
                  aria-label="Ampliar tela <%= hero.mockups.professor.label %>"
                  class="w-1/2 transform -rotate-2 hover:rotate-0 focus-visible:rotate-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-3xl transition-transform duration-500 relative z-10 flex flex-col cursor-pointer group"
                  onclick="openLightbox('<%= hero.mockups.professor.image %>', '<%= hero.mockups.professor.label %>', 'Visão executiva de presença, ocupação de tatames, alunos prontos para graduar e frequência em tempo real.')"
                  onkeydown="handleCardKeydown(event, () => openLightbox('<%= hero.mockups.professor.image %>', '<%= hero.mockups.professor.label %>', 'Visão executiva de presença, ocupação de tatames, alunos prontos para graduar e frequência em tempo real.'))"
                  title="Clique para ampliar ou passe o mouse para rolar a tela"
                >
                  <%- include('partials/phone-frame', {
                    image: hero.mockups.professor.image,
                    alt: hero.mockups.professor.alt,
                    maxWidthClass: 'max-w-[240px]',
                    ringHoverClass: 'group-hover:ring-primary/50',
                    showZoomBadge: true
                  }) %>
                  <div class="mt-2.5 mx-auto bg-surface-container-high px-2.5 sm:px-3 py-1 rounded-full text-center shadow-md border border-white/5 max-w-full">
                    <span class="font-label-sm text-[9px] sm:text-label-sm text-primary flex items-center justify-center gap-1 whitespace-nowrap">
                      <span class="material-symbols-outlined text-[13px] sm:text-[14px]"><%= hero.mockups.professor.icon %></span>
                      <%= hero.mockups.professor.label %>
                    </span>
                  </div>
                </div>

                <div
                  role="button"
                  tabindex="0"
                  aria-label="Ampliar tela <%= hero.mockups.aluno.label %>"
                  class="w-1/2 transform rotate-2 hover:rotate-0 focus-visible:rotate-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tertiary rounded-3xl transition-transform duration-500 relative z-20 flex flex-col -mt-4 sm:-mt-8 cursor-pointer group"
                  onclick="openLightbox('<%= hero.mockups.aluno.image %>', '<%= hero.mockups.aluno.label %>', 'Check-in rápido em 1 toque, acompanhamento semanal de meta de treinos e progresso rumo ao próximo grau.')"
                  onkeydown="handleCardKeydown(event, () => openLightbox('<%= hero.mockups.aluno.image %>', '<%= hero.mockups.aluno.label %>', 'Check-in rápido em 1 toque, acompanhamento semanal de meta de treinos e progresso rumo ao próximo grau.'))"
                  title="Clique para ampliar ou passe o mouse para rolar a tela"
                >
                  <%- include('partials/phone-frame', {
                    image: hero.mockups.aluno.image,
                    alt: hero.mockups.aluno.alt,
                    fetchpriority: 'high',
                    maxWidthClass: 'max-w-[240px]',
                    ringHoverClass: 'group-hover:ring-tertiary/50',
                    showZoomBadge: true
                  }) %>
                  <div class="mt-2.5 mx-auto bg-surface-container-high px-2.5 sm:px-3 py-1 rounded-full text-center shadow-md border border-white/5 max-w-full">
                    <span class="font-label-sm text-[9px] sm:text-label-sm text-tertiary flex items-center justify-center gap-1 whitespace-nowrap">
                      <span class="material-symbols-outlined text-[13px] sm:text-[14px]"><%= hero.mockups.aluno.icon %></span>
                      <%= hero.mockups.aluno.label %>
                    </span>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>

        <section class="w-full bg-surface-container-lowest py-6 sm:py-space-xl px-4 sm:px-6 lg:px-12 border-y border-white/5">
          <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-space-md">
              <% stats.forEach(function(stat) { %>
                <div class="scroll-reveal flex flex-col items-center sm:items-start p-4 sm:p-space-lg rounded-xl bg-surface-container shadow-sm border border-white/5 text-center sm:text-left">
                  <span class="font-stat-counter text-2xl sm:text-stat-counter <%= stat.colorClass %> font-black"><%= stat.value %></span>
                  <span class="font-headline-sm text-sm sm:text-headline-sm font-semibold text-on-surface mt-0.5"><%= stat.title %></span>
                  <span class="font-body-sm text-[11px] sm:text-body-sm text-on-surface-variant mt-0.5"><%= stat.subtitle %></span>
                </div>
              <% }); %>
            </div>
          </div>
        </section>
      </div>

      <section class="w-full bg-surface py-8 sm:py-space-xl lg:py-24 px-4 sm:px-6 lg:px-12 scroll-mt-20" id="vitrine-app-section">
        <div class="max-w-7xl mx-auto flex flex-col gap-6 sm:gap-space-xl" id="showcase-tabs-container">

          <div class="text-center max-w-3xl mx-auto flex flex-col gap-space-xs">
            <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">
              VITRINE INTERATIVA &amp; ARQUITETURA DE RECURSOS
            </span>
            <h2 class="font-headline-lg text-[22px] sm:text-headline-lg font-bold text-on-surface leading-tight">
              Feito para atender as duas pontas do Dojô: Atletas e Mestres
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Elimine a burocracia de recepção e mantenha o foco no tatame. Teste o simulador interativo abaixo ou alterne entre a visão do Aluno e do Professor para explorar cada recurso e tela do aplicativo.
            </p>
          </div>

          <div class="scroll-reveal bg-surface-container-lowest rounded-2xl sm:rounded-3xl p-4 sm:p-8 lg:p-10 border border-white/10 shadow-xl relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-80 h-80 bg-primary-container/10 blur-[100px] rounded-full pointer-events-none"></div>
            <div class="flex flex-col lg:flex-row items-center gap-6 sm:gap-8 lg:gap-12 relative z-10">

              <div class="w-full lg:w-7/12 flex flex-col gap-space-md">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-space-sm">

                  <div class="grid grid-cols-2 sm:flex items-center bg-surface-container p-1 rounded-xl border border-white/5 w-full sm:w-auto" role="group" aria-label="Alternar perfil no simulador">
                    <button
                      type="button"
                      id="sim-role-aluno"
                      aria-pressed="true"
                      onclick="setSimulatorRole('aluno')"
                      class="px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1"
                    >
                      <span class="material-symbols-outlined text-[16px] shrink-0">person</span>
                      <span class="truncate">App do Aluno</span>
                    </button>
                    <button
                      type="button"
                      id="sim-role-professor"
                      aria-pressed="false"
                      onclick="setSimulatorRole('professor')"
                      class="px-2.5 sm:px-3 py-1.5 rounded-lg font-label-md text-label-md transition-all text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1"
                    >
                      <span class="material-symbols-outlined text-[16px] shrink-0">sports</span>
                      <span class="truncate">App do Professor</span>
                    </button>
                  </div>
                </div>

                <div>
                  <span id="sim-badge" class="font-label-sm text-label-sm text-primary uppercase tracking-widest">
                    <%= simulator.aluno[0].badge %>
                  </span>
                  <h3 id="sim-title" class="font-headline-lg text-xl sm:text-headline-lg font-bold text-on-surface mt-1">
                    <%= simulator.aluno[0].title %>
                  </h3>
                  <p id="sim-desc" class="font-body-lg text-sm sm:text-body-lg text-on-surface-variant mt-2">
                    <%= simulator.aluno[0].description %>
                  </p>
                </div>

                <div class="flex flex-col gap-2 pt-1 sm:pt-2">
                  <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">
                    CLIQUE NAS ABAS DO APLICATIVO PARA NAVEGAR:
                  </span>
                  <div id="sim-tabs-bar" class="grid grid-cols-5 gap-1 sm:gap-2 bg-surface-container p-1.5 sm:p-2 rounded-2xl border border-white/5">
                    <% simulator.aluno.forEach(function(t, idx) { %>
                      <button
                        type="button"
                        aria-pressed="<%= idx === 0 ? 'true' : 'false' %>"
                        onclick="selectSimulatorTab(<%= idx %>)"
                        class="sim-tab-btn flex flex-col items-center justify-center py-2 sm:py-2.5 px-0.5 sm:px-1 rounded-xl transition-all min-w-0 <%= idx === 0 ? 'bg-primary-container text-on-primary-container font-bold shadow-md' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>"
                      >
                        <span class="material-symbols-outlined text-[18px] sm:text-[20px]"><%= t.icon %></span>
                        <span class="font-label-sm text-[10px] sm:text-[11px] mt-1 truncate max-w-full"><%= t.tab %></span>
                      </button>
                    <% }); %>
                  </div>
                </div>

                <div class="flex items-center gap-space-sm text-on-surface-variant font-body-sm text-body-sm pt-1">
                  <span class="material-symbols-outlined text-primary text-[18px] shrink-0">touch_app</span>
                  <span>Toque ou passe o mouse sobre o celular para explorar a tela ou clique para ampliar.</span>
                </div>
              </div>

              <div class="w-full lg:w-5/12 flex flex-col items-center justify-center">
                <div
                  role="button"
                  tabindex="0"
                  aria-label="Abrir tela atual do simulador em tela cheia"
                  class="w-full cursor-pointer group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-3xl"
                  onclick="openSimulatorLightbox()"
                  onkeydown="handleCardKeydown(event, openSimulatorLightbox)"
                  title="Clique para abrir em tela cheia"
                >
                  <%- include('partials/phone-frame', {
                    imgId: 'sim-phone-img',
                    image: simulator.aluno[0].image,
                    alt: simulator.aluno[0].title,
                    loading: 'lazy',
                    maxWidthClass: 'max-w-[260px]',
                    ringHoverClass: 'group-hover:ring-primary',
                    showZoomBadge: true
                  }) %>
                </div>
              </div>

            </div>
          </div>

          <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 sm:gap-space-md pt-2" id="galeria-telas-anchor">
            <div class="flex flex-col gap-space-xs">
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">
                RECURSOS &amp; TELAS POR PERFIL
              </span>
              <h3 class="font-headline-md text-lg sm:text-headline-md font-bold text-on-surface">
                Explore os Recursos e as Telas Nativas de Cada Visão
              </h3>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center bg-surface-container-high p-1.5 rounded-xl w-full md:w-auto border border-white/5 gap-1 sm:gap-0" role="tablist">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                aria-expanded="true"
                aria-controls="content-aluno"
                class="px-3 sm:px-space-md py-2.5 rounded-lg font-label-lg text-xs sm:text-label-lg transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1.5 shadow-sm"
                id="tab-aluno"
                onclick="switchTab('aluno')"
              >
                <span class="material-symbols-outlined text-[18px] shrink-0">sports_martial_arts</span>
                <span>Para Alunos &amp; Competidores</span>
              </button>
              <button
                type="button"
                role="tab"
                aria-selected="false"
                aria-expanded="false"
                aria-controls="content-professor"
                class="px-3 sm:px-space-md py-2.5 rounded-lg font-label-lg text-xs sm:text-label-lg transition-all text-on-surface-variant hover:text-on-surface font-medium flex items-center justify-center gap-1.5"
                id="tab-professor"
                onclick="switchTab('professor')"
              >
                <span class="material-symbols-outlined text-[18px] shrink-0">shield</span>
                <span>Para Professores &amp; Mestres</span>
              </button>
            </div>
          </div>

          <div id="content-aluno" class="showcase-panel">
            <div class="flex flex-col gap-space-lg">

              <div class="p-space-lg sm:p-space-xl bg-surface-container-lowest rounded-2xl border border-primary/20 shadow-md flex flex-col gap-space-md">
                <div class="flex flex-wrap items-center justify-between gap-space-sm border-b border-white/5 pb-space-sm">
                  <div class="flex items-center gap-space-sm">
                    <div class="w-11 h-11 rounded-xl bg-primary-container/20 flex items-center justify-center text-primary">
                      <span class="material-symbols-outlined text-[26px]">sports_martial_arts</span>
                    </div>
                    <div>
                      <h4 class="font-headline-sm text-headline-sm font-bold text-on-surface">Recursos para Alunos &amp; Competidores</h4>
                      <span class="font-label-sm text-label-sm text-primary uppercase">Autonomia, Check-in Rápido &amp; Evolução Clara</span>
                    </div>
                  </div>
                  <span class="px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm">
                    6 Telas Nativas Abaixo
                  </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
                  <% features.aluno.forEach(function(feat) { %>
                    <div class="flex items-start gap-space-sm p-space-sm rounded-xl bg-surface-container/70 border border-white/5">
                      <div class="p-1.5 rounded-lg bg-surface-container-high text-primary shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[18px]"><%= feat.icon %></span>
                      </div>
                      <div>
                        <h5 class="font-label-lg text-label-lg font-bold text-on-surface"><%= feat.title %></h5>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5"><%= feat.description %></p>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-lg">
